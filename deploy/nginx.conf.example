# Nginx reverse proxy for GRN Desk on a Hostinger VPS.
#
# Copy to /etc/nginx/sites-available/grn-desk, edit server_name, then:
#   sudo ln -s /etc/nginx/sites-available/grn-desk /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# After DNS points at the VPS, add HTTPS with:
#   sudo certbot --nginx -d your-domain.com -d www.your-domain.com
# Certbot rewrites this file to add the :443 block and an http->https redirect.

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com;

    # Excel / PDF uploads are parsed on the client and posted as JSON; the server
    # accepts up to 4mb, so give a little headroom here.
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade so Socket.IO (live sync) works through the proxy.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Keep long-lived websocket connections open.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
