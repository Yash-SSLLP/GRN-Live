# Copy to .env and adjust. Never commit the real .env (it's gitignored).
# For Atlas, use your own connection string and URL-ENCODE any special characters
# in the password (e.g. @ -> %40, # -> %23), otherwise the URI will not parse.
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/grn?appName=Cluster0

# A long random string signs the login tokens — CHANGE THIS. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-me-to-a-long-random-string

PORT=5000
# Production only: bind to localhost so only Nginx can reach Node. Leave unset for
# local/LAN dev (listens on all interfaces).
# HOST=127.0.0.1

# First admin created by `npm run seed` — change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS/socket origin. Single-service deploy (Express serves the client) is
# same-origin, so `*` is fine; set it to your domain to lock it down.
CLIENT_ORIGIN=*
